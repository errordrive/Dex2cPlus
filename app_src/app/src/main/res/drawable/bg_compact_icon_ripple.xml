<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#305b8def"
    android:radius="20dp">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#ffffffff"/>
            <size
                android:height="40dp"
                android:width="40dp"/>
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="#225b8def"/>
                    <size
                        android:height="40dp"
                        android:width="40dp"/>
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="oval">
                    <solid android:color="#185b8def"/>
                    <size
                        android:height="40dp"
                        android:width="40dp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
