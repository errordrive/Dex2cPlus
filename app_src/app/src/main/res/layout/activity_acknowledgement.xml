<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootAcknowledgement"
    android:background="@color/md_theme_surfaceContainer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/headerAcknowledgement"
        android:background="@color/md_theme_headerSurface"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/btnAckBack"
            android:background="@drawable/bg_compact_icon_ripple"
            android:padding="8dp"
            android:longClickable="false"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:contentDescription="Back"
            app:tint="@color/md_theme_onHeader"/>
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Credits"
            android:singleLine="true"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <ScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="26dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardAckArchitect"
                android:background="@drawable/bg_ack_card"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="2.5dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dex2cPlus"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Core DEX to C++ transpilation engine, native JNI obfuscation pipeline and Android app architect @errordrive"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardAckSmali"
                android:background="@drawable/bg_ack_card"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="2.5dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Smali &amp; Dexlib2"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Powerful Android DEX file parsing, manipulation and bytecode reading framework."
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardAckClang"
                android:background="@drawable/bg_ack_card"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="2.5dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LLVM Clang &amp; LLD"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Native C/C++17 compilation toolchain and high-speed ELF shared library (.so) linker."
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardAckNdk"
                android:background="@drawable/bg_ack_card"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="2.5dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Android NDK"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Multi-ABI native development headers, JNI runtime interfaces and platform sysroot libraries."
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardAckMaterial"
                android:background="@drawable/bg_ack_card"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:elevation="2.5dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AndroidX &amp; Material 3"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Modern Android UI foundation, tree list RecyclerView components and adaptive DayNight theming."
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
