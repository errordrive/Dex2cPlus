<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:background="@color/md_theme_surfaceContainer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/headerContainer"
            android:background="@color/md_theme_headerSurface"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="18dp"
            android:paddingEnd="6dp">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onHeader"
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/btnHeaderApkPicker"
                android:background="@drawable/bg_compact_icon_ripple"
                android:padding="8dp"
                android:longClickable="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_apk_default"
                android:scaleType="centerInside"
                android:contentDescription="Select Target APK"
                app:tint="@color/md_theme_onHeader"/>
            <ImageButton
                android:id="@+id/btnHeaderTelegram"
                android:background="@drawable/bg_compact_icon_ripple"
                android:padding="8dp"
                android:longClickable="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_telegram"
                android:scaleType="centerInside"
                android:contentDescription="Telegram"
                android:layout_marginStart="2dp"
                app:tint="@color/md_theme_onHeader"/>
            <ImageButton
                android:id="@+id/btnMoreMenu"
                android:background="@drawable/bg_compact_icon_ripple"
                android:padding="8dp"
                android:longClickable="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_more_vert"
                android:scaleType="centerInside"
                android:contentDescription="Menu"
                android:layout_marginStart="2dp"
                app:tint="@color/md_theme_onHeader"/>
        </LinearLayout>
        <com.dex2c.plus.ui.ShimmerFrameLayout
            android:id="@+id/filterBarContainer"
            android:background="@color/md_theme_surfaceElevated"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/filterBarContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Filter"
                    app:tint="@color/md_theme_onSurfaceVariant"/>
                <EditText
                    android:textSize="13.5sp"
                    android:textColor="@color/md_theme_onSurface"
                    android:textColorHint="@color/md_theme_onSurfaceVariant"
                    android:id="@+id/etFilter"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="Search..."
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:layout_marginStart="10dp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swTreeMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOn=""
                    android:textOff=""
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text=""
                    android:layout_marginStart="6dp"
                    android:showText="false"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:id="@+id/tvSelectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:fontFamily="monospace"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"/>
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:buttonTint="@color/md_theme_primary"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/shimmerFilterLoading"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">
                <View
                    android:background="@drawable/bg_shimmer_node_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>
                <View
                    android:background="@drawable/bg_shimmer_bar"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="28dp"/>
                <View
                    android:background="@drawable/bg_shimmer_node_icon"
                    android:layout_width="34dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"/>
                <View
                    android:background="@drawable/bg_shimmer_bar"
                    android:layout_width="16dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <View
                    android:background="@drawable/bg_shimmer_checkbox"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
        </com.dex2c.plus.ui.ShimmerFrameLayout>
