<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_filepicker_surface"
    android:paddingTop="20dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_onSurface"
        android:id="@+id/tvNdkDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Native code support"
        android:singleLine="true"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:id="@+id/tvNdkDialogStatusBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Install/Uninstall native code (C/C++) build support!"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/containerNdkInstallOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <EditText
                android:textSize="13sp"
                android:textColor="@color/md_theme_onSurface"
                android:textColorHint="@color/md_theme_onSurfaceVariant"
                android:id="@+id/etNdkLocalPath"
                android:background="@drawable/bg_ndk_input_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Enter path..."
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionDone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <ImageButton
                android:id="@+id/btnNdkBrowseFile"
                android:background="@drawable/bg_ndk_input_box"
                android:padding="9dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_folder_open"
                android:scaleType="centerInside"
                android:contentDescription="Select File"
                android:layout_marginStart="8dp"
                app:tint="@color/md_theme_primary"/>
        </LinearLayout>
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnNdkLocalInstall"
            android:background="@drawable/bg_ndk_input_box"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="INSTALL FROM PATH"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/containerNdkLiveProgress"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                android:id="@+id/tvNdkLiveStage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Installing..."
                android:singleLine="true"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_primary"
                android:id="@+id/tvNdkLivePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:fontFamily="monospace"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/pbNdkLiveProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressTint="@color/md_theme_primary"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:ellipsize="middle"
            android:id="@+id/tvNdkLiveDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Preparing toolchain files..."
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/studio_danger"
            android:gravity="center"
            android:id="@+id/btnNdkUninstall"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="UNINSTALL"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnNdkOnlineInstall"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="ONLINE INSTALL"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnNdkDialogClose"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="CANCEL"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
