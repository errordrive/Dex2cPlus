<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_filepicker_surface"
    android:paddingTop="20dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_onSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ABIs Configuration"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowAbiArm32"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15.5sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="armeabi-v7a"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAbiArm32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowAbiArm64"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15.5sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="arm64-v8a"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAbiArm64"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowAbiX86"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15.5sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="x86"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAbiX86"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowAbiX8664"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15.5sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="x86_64"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAbiX8664"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnAbisCancel"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="CANCEL"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnAbisOk"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="OK"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
