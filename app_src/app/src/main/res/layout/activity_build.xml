<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootBuild"
    android:background="@color/console_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/headerBuild"
        android:background="@color/md_theme_headerSurface"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">
        <ImageButton
            android:id="@+id/btnBuildBack"
            android:background="@drawable/bg_compact_icon_ripple"
            android:padding="8dp"
            android:longClickable="false"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:contentDescription="Back"
            app:tint="@color/md_theme_onHeader"/>
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onHeader"
            android:id="@+id/tvBuildTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Output"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/btnCopyConsole"
            android:background="@drawable/bg_compact_pill_ripple"
            android:focusable="true"
            android:clickable="true"
            android:longClickable="false"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy_log"
                android:contentDescription="Copy"
                app:tint="@color/md_theme_onHeader"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.dex2c.plus.ui.GlowConsoleTextView
            android:id="@+id/tvConsoleOutput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="top"
            android:background="@drawable/bg_console_fade_top"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/bg_console_fade_bottom"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="28dp"/>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/btnCancelBuild"
            android:background="@drawable/bg_circle_build_btn"
            android:padding="11dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="18dp"
            android:src="@drawable/ic_cancel_build"
            android:scaleType="fitCenter"
            android:contentDescription="Cancel"
            android:layout_marginEnd="18dp"
            android:elevation="6dp"
            app:tint="@color/md_theme_onPrimary"/>
    </FrameLayout>
</LinearLayout>
