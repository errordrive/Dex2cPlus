<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_filepicker_surface"
    android:paddingTop="20dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_onSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Output Selection"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/rgOutputOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:textSize="15.5sp"
            android:textColor="@color/md_theme_onSurface"
            android:id="@+id/rbOutputDefault"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Default (Dex2cPlus Folder)"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:buttonTint="@color/md_theme_primary"/>
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:textSize="15.5sp"
            android:textColor="@color/md_theme_onSurface"
            android:id="@+id/rbOutputApkFolder"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Selected APK Folder"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:buttonTint="@color/md_theme_primary"/>
    </RadioGroup>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnOutputCancel"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="CANCEL"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
