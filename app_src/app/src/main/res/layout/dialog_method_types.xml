<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_filepicker_surface"
    android:paddingTop="20dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_onSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Method Types Configuration"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowDialogTypeSynthetic"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="synthetic"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDialogTypeSynthetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowDialogTypeBridge"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="bridge"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDialogTypeBridge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowDialogTypeStatic"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="static"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDialogTypeStatic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowDialogTypeVirtual"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="virtual"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDialogTypeVirtual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowDialogTypePrivate"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="private"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDialogTypePrivate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowDialogTypeSynchronized"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="synchronized"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDialogTypeSynchronized"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowDialogTypeVarargs"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="varargs"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDialogTypeVarargs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnMethodTypesCancel"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="CANCEL"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnMethodTypesOk"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="OK"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
