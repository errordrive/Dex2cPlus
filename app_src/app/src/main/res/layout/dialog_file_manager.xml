<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_filepicker_surface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_filepicker_header"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_folder_header"
            android:contentDescription="Folder"
            app:tint="@color/md_theme_onHeader"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onHeader"
                android:id="@+id/tvFmTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select APK"/>
            <TextView
                android:textSize="12.5sp"
                android:textColor="@color/md_theme_onHeaderVariant"
                android:ellipsize="start"
                android:id="@+id/tvFmCurrentPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="/storage/emulated/0"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/btnFmUp"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_folder_open"
            android:contentDescription="Parent Directory"
            app:tint="@color/folder_icon_tint"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=".."/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parent folder"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFiles"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="410dp"
        android:overScrollMode="ifContentScrolls"/>
    <TextView
        android:textSize="13.5sp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:gravity="center"
        android:id="@+id/tvFmEmpty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:text="No folders or APK files found"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnFmClose"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="CANCEL"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:enabled="false"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:gravity="center"
            android:id="@+id/btnFmSelect"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="SELECT"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>
    </LinearLayout>
</LinearLayout>
