<?xml version="1.0" encoding="utf-8"?>
<com.dex2c.plus.ui.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerTelegramRoot"
    android:background="@drawable/bg_filepicker_surface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/telegramProfileContent"
        android:paddingTop="22dp"
        android:paddingBottom="12dp"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">
            <FrameLayout
                android:id="@+id/avatarCircleContainer"
                android:background="@drawable/bg_profile_avatar_circle"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:elevation="3dp"
                android:outlineSpotShadowColor="@color/ack_card_shadow"
                android:outlineAmbientShadowColor="@color/ack_card_shadow">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_telegram_profile_avatar"
                    android:scaleType="centerCrop"
                    android:contentDescription="Official Profile Icon"/>
            </FrameLayout>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                android:id="@+id/tvProfileHandle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@INCoderDev"
                android:singleLine="true"/>
            <TextView
                android:textSize="12.5sp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:id="@+id/tvProfileSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Official Developer &amp; Community"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cardContactUs"
                android:background="@drawable/bg_telegram_option_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:elevation="2dp"
                android:outlineSpotShadowColor="@color/ack_card_shadow"
                android:outlineAmbientShadowColor="@color/ack_card_shadow">
                <FrameLayout
                    android:background="@drawable/bg_icon_box_blue"
                    android:layout_width="38dp"
                    android:layout_height="38dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_ack_author"
                        android:contentDescription="Contact Us"
                        app:tint="@color/md_theme_primary"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_onSurface"
                        android:id="@+id/tvContactUsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact Us"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:id="@+id/tvContactUsSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@INCoderDev"
                        android:singleLine="true"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_ack_link"
                    android:contentDescription="Open"
                    app:tint="@color/md_theme_onSurfaceVariant"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cardJoinTelegram"
                android:background="@drawable/bg_telegram_option_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:elevation="2dp"
                android:outlineSpotShadowColor="@color/ack_card_shadow"
                android:outlineAmbientShadowColor="@color/ack_card_shadow">
                <FrameLayout
                    android:background="@drawable/bg_icon_box_blue"
                    android:layout_width="38dp"
                    android:layout_height="38dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_telegram"
                        android:contentDescription="Join Telegram"
                        app:tint="@color/md_theme_primary"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_onSurface"
                        android:id="@+id/tvJoinTelegramTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Join Telegram"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:id="@+id/tvJoinTelegramSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@INCoderX"
                        android:singleLine="true"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_ack_link"
                    android:contentDescription="Open"
                    app:tint="@color/md_theme_onSurfaceVariant"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_primary"
                android:gravity="center"
                android:id="@+id/btnTelegramClose"
                android:background="@drawable/bg_compact_menu_ripple"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="CLOSE"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/shimmerTelegramLoading"
        android:paddingTop="22dp"
        android:paddingBottom="12dp"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">
            <View
                android:background="@drawable/bg_profile_avatar_circle"
                android:layout_width="68dp"
                android:layout_height="68dp"/>
            <View
                android:background="@drawable/bg_shimmer_bar"
                android:layout_width="128dp"
                android:layout_height="18dp"
                android:layout_marginTop="14dp"/>
            <View
                android:background="@drawable/bg_shimmer_bar"
                android:layout_width="180dp"
                android:layout_height="13dp"
                android:layout_marginTop="7dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_telegram_option_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <View
                    android:background="@drawable/bg_shimmer_node_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <View
                        android:background="@drawable/bg_shimmer_bar"
                        android:layout_width="104dp"
                        android:layout_height="14dp"/>
                    <View
                        android:background="@drawable/bg_shimmer_bar"
                        android:layout_width="84dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
                <View
                    android:background="@drawable/bg_shimmer_bar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_telegram_option_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <View
                    android:background="@drawable/bg_shimmer_node_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <View
                        android:background="@drawable/bg_shimmer_bar"
                        android:layout_width="118dp"
                        android:layout_height="14dp"/>
                    <View
                        android:background="@drawable/bg_shimmer_bar"
                        android:layout_width="78dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
                <View
                    android:background="@drawable/bg_shimmer_bar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:paddingStart="12dp"
            android:paddingEnd="20dp">
            <View
                android:background="@drawable/bg_shimmer_bar"
                android:layout_width="54dp"
                android:layout_height="16dp"/>
        </LinearLayout>
    </LinearLayout>
</com.dex2c.plus.ui.ShimmerFrameLayout>
