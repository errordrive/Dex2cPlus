<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_filepicker_surface"
    android:paddingTop="20dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_onSurface"
        android:id="@+id/tvCustomInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Custom library name"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"/>
    <EditText
        android:textSize="15sp"
        android:textColor="@color/md_theme_onSurface"
        android:textColorHint="@color/md_theme_onSurfaceVariant"
        android:id="@+id/etCustomInputValue"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Enter library name (default: native-lib)"
        android:singleLine="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:backgroundTint="@color/md_theme_primary"
        android:importantForAutofill="no"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnCustomInputCancel"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="CANCEL"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:gravity="center"
            android:id="@+id/btnCustomInputOk"
            android:background="@drawable/bg_compact_menu_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="OK"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
